{
  "name": "goidojo-ios",
  "version": "1.0.0",
  "private": true,
  "description": "語彙道場 語彙力トレーニング iOSアプリ (Capacitorラッパー)",
  "scripts": {
    "sync-web": "bash sync-web.sh",
    "add-ios": "npm run sync-web && npx cap add ios && npx cap sync ios",
    "sync": "npm run sync-web && npx cap sync ios",
    "open": "npx cap open ios",
    "icons": "npx @capacitor/assets generate --ios --iconBackgroundColor '#0A0D1A' --iconBackgroundColorDark '#0A0D1A' --splashBackgroundColor '#0A0D1A' --splashBackgroundColorDark '#0A0D1A'"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/preferences": "^7.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
